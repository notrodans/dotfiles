# Mapping j/k to move down/up instead of visual mark movement
move_down j
move_up k

# Ensure arrow keys still work
move_down <down>
move_up <up>

# Vim-like half-page scrolling (uses move_screen_ratio 0.5)
screen_down <C-d>
screen_up <C-u>

# Zathura-like full-page scrolling
next_page <space>
previous_page <S-<space>>
