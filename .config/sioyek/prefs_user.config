# Window size
single_main_window_size 1000 3000

# Page separator (approximate to page-padding)
page_separator_width 10

# Font settings
ui_font Go Mono
font_size 14

# Movement and overlap
# Vim-like half-page scrolling ratio for screen_down/screen_up
move_screen_ratio 0.5
# Approximate scroll-step 40 (assuming pixels to inches conversion or similar)
vertical_move_amount 0.4

# Startup commands
startup_commands fit_to_page_width

# Disable loading screen/checkerboard (similar to render-loading false)
should_draw_unrendered_pages 0
