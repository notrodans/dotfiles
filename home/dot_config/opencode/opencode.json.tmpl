{
	"$schema": "https://opencode.ai/config.json",
	"theme": "system",
	"permission": {
		"bash": {
			"git push*": "ask",
			"git remote*": "ask",
			"gh *": "ask"
		},
		"github_push_files": "ask",
		"github_create_or_update_file": "ask",
		"github_delete_file": "ask",
		"github_create_pull_request": "ask",
		"github_merge_pull_request": "ask",
		"github_issue_write": "ask",
		"github_create_branch": "ask",
		"github_create_repository": "ask"
	},
	"agent": {
		"plan": {
			"permission": {
				"skill": {
					"internal-*": "allow"
				}
			}
		}
	},
	"mcp": {
		"chrome-devtools": {
			"type": "local",
			"command": ["npx", "chrome-devtools-mcp@latest"]
		},
		"DeepWiki": {
			"type": "remote",
{{- if .secrets }}
			"url": "https://mcp.fastmcp.me/9a199fde-af87-4253-bacd-022a69eb0193/69/mcp?fastmcp_gateway_key={{ (bitwarden "item" "fastmcp-key").login.password }}"
{{- else }}
			"url": "https://mcp.fastmcp.me/9a199fde-af87-4253-bacd-022a69eb0193/69/mcp?fastmcp_gateway_key=PLACEHOLDER"
{{- end }}
		},
		"dockerhub": {
			"type": "local",
			"command": [
				"docker",
				"run",
				"-i",
				"--rm",
				"-e",
{{- if .secrets }}
				"HUB_PAT_TOKEN={{ (bitwarden "item" "dockerhub-token").login.password }}",
{{- else }}
				"HUB_PAT_TOKEN=PLACEHOLDER",
{{- end }}
				"mcp/dockerhub",
				"--transport=stdio",
				"--username={{ .user }}"
			]
		}
{{- if .secrets }},
		"github": {
			"type": "remote",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer {{ (bitwarden "item" "github-token").login.password }}"
			}
		}
{{- end }}
	},
	"lsp": {
		"python": {
			"command": [
				"{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/basedpyright-langserver",
				"--stdio"
			],
			"extensions": [".py", ".pyi"]
		},
		"bash": {
			"command": [
				"{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/bash-language-server",
				"start"
			],
			"extensions": [".sh", ".bash"]
		},
		"go": {
			"command": ["{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/gopls"],
			"extensions": [".go"]
		},
		"java": {
			"command": [
				"{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/jdtls",
				"--data",
				"--jvm-arg=-javaagent:{{ .chezmoi.homeDir }}/.local/share/nvim/mason/packages/jdtls/lombok.jar"
			],
			"extensions": [".java"],
			"initialization": {
				"redhat": { "telemetry": { "enabled": false } },
				"java": {
					"jdt": {
						"ls": {
							"lombokSupport": { "enabled": true },
							"protobufSupport": { "enabled": true }
						}
					},
					"path": "{{ .chezmoi.homeDir }}/.sdkman/candidates/java/java-21.0.10-tem",
					"sources": {
						"organizeImports": {
							"starThreshold": 9999,
							"staticStarThreshold": 9999
						}
					},
					"implementationsCodeLens": { "enabled": true },
					"referencesCodeLens": { "enabled": true },
					"references": { "includeDecompiledSources": true },
					"inlayHints": { "parameterNames": { "enabled": "all" } },
					"codeGeneration": {
						"toString": {
							"template": "${object.className}{${member.name()}=${member.value}, ${otherMembers}}"
						},
						"hashCodeEquals": { "useJava7Objects": true },
						"useBlocks": true
					},
					"maven": { "downloadSources": true },
					"format": {
						"settings": {
							"url": "{{ .chezmoi.homeDir }}/eclipse-my-style.xml",
							"profile": "Eclipse"
						}
					},
					"compile": {
						"nullAnalysis": {
							"nonnull": [
								"lombok.NonNull",
								"javax.annotation.Nonnull",
								"org.eclipse.jdt.annotation.NonNull",
								"org.springframework.lang.NonNull"
							]
						}
					},
					"eclipse": { "downloadSources": true },
					"completion": {
						"chain": { "enabled": false },
						"guessMethodArguments": "off",
						"favouriteStaticMembers": [
							"org.junit.jupiter.api.Assertions.*",
							"org.junit.jupiter.api.Assumptions.*",
							"org.mockito.Mockito.*",
							"java.util.Objects.*"
						]
					},
					"signatureHelp": {
						"enabled": true,
						"description": { "enabled": true }
					},
					"configuration": {
						"runtimes": [
							{
								"name": "JavaSE-25",
								"path": "{{ .chezmoi.homeDir }}/.sdkman/candidates/java/java-25.0.2-tem"
							},
							{
								"name": "JavaSE-21",
								"path": "{{ .chezmoi.homeDir }}/.sdkman/candidates/java/java-21.0.10-tem"
							},
							{
								"name": "JavaSE-17",
								"path": "{{ .chezmoi.homeDir }}/.sdkman/candidates/java/java-17.0.18-tem"
							}
						]
					}
				}
			}
		},
		"lua": {
			"command": ["{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/lua-language-server"],
			"extensions": [".lua"]
		},
		"markdown": {
			"command": ["{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/marksman", "server"],
			"extensions": [".md", ".markdown"]
		},
		"php": {
			"command": [
				"{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/intelephense",
				"--stdio"
			],
			"extensions": [".php"],
			"initialization": {
				"intelephense": {
					"telemetry": { "enabled": false },
					"files": { "maxSize": 5000000 }
				}
			}
		},
		"typescript": {
			"command": ["{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/vtsls", "--stdio"],
			"extensions": [
				".ts",
				".tsx",
				".vue",
				".js",
				".jsx",
				".mjs",
				".cjs",
				".json"
			],
			"initialization": {
				"complete_function_calls": true,
				"vtsls": {
					"enableMoveToFileCodeAction": true,
					"autoUseWorkspaceTsdk": true,
					"experimental": {
						"maxInlayHintLength": 30,
						"completion": { "enableServerSideFuzzyMatch": true }
					},
					"tsserver": {
						"globalPlugins": [
							{
								"name": "@vue/typescript-plugin",
								"location": "{{ .chezmoi.homeDir }}/.local/share/nvim/mason/packages/vue-language-server/node_modules/@vue/language-server",
								"languages": ["vue"],
								"configNamespace": "typescript",
								"enableForWorkspaceTypeScriptVersions": true
							}
						]
					}
				},
				"typescript": {
					"updateImportsOnFileMove": { "enabled": "always" },
					"suggest": { "completeFunctionCalls": true },
					"inlayHints": {
						"enumMemberValues": { "enabled": true },
						"functionLikeReturnTypes": { "enabled": true },
						"parameterNames": { "enabled": "literals" },
						"parameterTypes": { "enabled": true },
						"propertyDeclarationTypes": { "enabled": true },
						"variableTypes": { "enabled": false }
					}
				},
				"javascript": {
					"updateImportsOnFileMove": { "enabled": "always" }
				}
			}
		},
		"css": {
			"command": [
				"{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/vscode-css-language-server",
				"--stdio"
			],
			"extensions": [".css", ".scss", ".less"]
		},
		"html": {
			"command": [
				"{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/vscode-html-language-server",
				"--stdio"
			],
			"extensions": [".html", ".htm"]
		},
		"json": {
			"command": [
				"{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/vscode-json-language-server",
				"--stdio"
			],
			"extensions": [".json", ".jsonc"],
			"initialization": {
				"json": {
					"validate": { "enable": true }
				}
			}
		},
		"vue": {
			"command": [
				"{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/vue-language-server",
				"--stdio"
			],
			"extensions": [".vue"]
		},
		"tailwindcss": {
			"command": [
				"{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/tailwindcss-language-server",
				"--stdio"
			],
			"extensions": [
				".css",
				".html",
				".js",
				".ts",
				".jsx",
				".tsx",
				".vue"
			],
			"initialization": {
				"tailwindCSS": {
					"experimental": {
						"classRegex": [
							[
								"cva|cn|cx\\(([^)]*)\\)",
								"[\"'`]([^\"'`]*).*?[\"'`]"
							]
						]
					}
				}
			}
		},
		"javascript": {
			"command": ["{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/biome", "lsp-proxy"],
			"extensions": [".js", ".jsx", ".mjs", ".cjs"],
			"initialization": {
				"biome": { "requireConfiguration": true }
			}
		},
		"gradle": {
			"command": ["{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/gradle-language-server"],
			"extensions": [".gradle", ".gradle.kts"]
		},
		"graphql": {
			"command": [
				"{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/graphql-lsp",
				"server",
				"-m",
				"stream"
			],
			"extensions": [".graphql", ".gql"]
		},
		"xml": {
			"command": ["{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/lemminx"],
			"extensions": [".xml"]
		},
		"prisma": {
			"command": [
				"{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/prisma-language-server",
				"--stdio"
			],
			"extensions": [".prisma"]
		},
		"stylelint": {
			"command": [
				"{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/stylelint-lsp",
				"--stdio"
			],
			"extensions": [".css", ".scss"]
		},
		"tex": {
			"command": ["{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/texlab"],
			"extensions": [".tex"]
		}
	}
}
