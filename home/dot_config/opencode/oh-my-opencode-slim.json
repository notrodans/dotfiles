{
	"$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
	"autoUpdate": false,
	"compactSidebar": true,
	"fallback": {
		"enabled": false
	},
	"multiplexer": {
		"type": "tmux"
	},
	"backgroundJobs": {
		"maxSessionsPerAgent": 2,
		"readContextMinLines": 10,
		"readContextMaxFiles": 8
	},
	"preset": "openai",
	"presets": {
		"openai": {
			"orchestrator": {
				"model": "openai/gpt-5.6-terra",
				"variant": "medium",
				"skills": ["*"],
				"mcps": ["*", "!context7"]
			},
			"oracle": {
				"model": "openai/gpt-5.6-sol",
				"variant": "high",
				"skills": ["simplify", "caveman"],
				"mcps": ["codegraph"]
			},
			"librarian": {
				"model": "openai/gpt-5.6-luna",
				"variant": "low",
				"skills": ["caveman"],
				"mcps": ["websearch", "context7", "gh_grep", "codegraph"]
			},
			"explorer": {
				"model": "openai/gpt-5.6-luna",
				"variant": "low",
				"skills": ["caveman"],
				"mcps": ["codegraph"]
			},
			"designer": {
				"model": "openai/gpt-5.6-luna",
				"variant": "medium",
				"skills": ["caveman"],
				"mcps": ["codegraph"]
			},
			"fixer": {
				"model": "openai/gpt-5.6-luna",
				"variant": "xhigh",
				"skills": ["caveman"],
				"mcps": ["codegraph"]
			},
			"commiter": {
				"model": "openai/gpt-5.6-luna",
				"variant": "medium",
				"skills": ["atomic-commits", "caveman"],
				"mcps": ["codegraph"],
				"orchestratorPrompt": "Delegate only when the user explicitly requests planning or creating a Git commit; never delegate for implementation completion, diff review, staging alone, or commit-message drafting."
			}
		},
		"opencode-go": {
			"orchestrator": {
				"model": "opencode-go/glm-5.2",
				"skills": ["*"],
				"mcps": ["*", "!context7"]
			},
			"oracle": {
				"model": "opencode-go/qwen3.7-max",
				"variant": "max",
				"skills": ["simplify"],
				"mcps": []
			},
			"librarian": {
				"model": "opencode-go/deepseek-v4-flash",
				"skills": [],
				"mcps": ["websearch", "context7", "gh_grep"]
			},
			"explorer": {
				"model": "opencode-go/deepseek-v4-flash",
				"skills": [],
				"mcps": []
			},
			"designer": {
				"model": "opencode-go/kimi-k2.7-code",
				"variant": "medium",
				"skills": [],
				"mcps": []
			},
			"fixer": {
				"model": "opencode-go/deepseek-v4-flash",
				"variant": "high",
				"skills": [],
				"mcps": []
			}
		}
	}
}
