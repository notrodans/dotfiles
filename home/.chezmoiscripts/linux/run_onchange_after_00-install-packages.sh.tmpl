{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

info() { echo -e "\033[34m[INFO]\033[0m $*"; }
warn() { echo -e "\033[33m[WARN]\033[0m $*"; }

has_systemd() {
  [[ -d /run/systemd/system ]]
}

check_pacman_lock() {
  if [[ -f /var/lib/pacman/db.lck ]]; then
    warn "Pacman database is locked (/var/lib/pacman/db.lck)."
    warn "If no other pacman/paru process is running, remove the lock file manually:"
    warn "  sudo rm /var/lib/pacman/db.lck"
    exit 1
  fi
}

if [[ ! -f /etc/arch-release ]]; then
  info "Not an Arch Linux system. Skipping Arch package installation."
  exit 0
fi

sync_arch_system() {
  if [[ ! -f /etc/pacman.d/gnupg/trustdb.gpg ]]; then
    info "Initializing Arch Linux package signing keys..."
    sudo pacman-key --init
    sudo pacman-key --populate archlinux
  fi

  info "Synchronizing repositories and upgrading the Arch system..."
  sudo pacman -Syu --needed --noconfirm archlinux-keyring

  if has_systemd; then
    sudo systemctl start archlinux-keyring-wkd-sync.timer || true
  fi
}

install_paru() {
  if command -v paru >/dev/null 2>&1; then
    info "paru already installed"
    return
  fi

  info "Installing paru..."
  sudo pacman -S --needed --noconfirm base-devel git

  (
    local temp_dir
    temp_dir=$(mktemp -d)
    trap 'rm -rf "$temp_dir"' EXIT

    git clone https://aur.archlinux.org/paru.git "$temp_dir"
    cd "$temp_dir"
    makepkg -si --noconfirm
  )
}

install_arch_packages() {
  info "Installing Arch Linux packages..."

  local packages=(
    {{ template "all_packages.tmpl" . }}
  )

{{ if .ci }}
  # AUR builds depend on external PKGBUILDs and source archives and make CI flaky.
  # Validate and install repository packages while leaving AUR builds to real installations.
  local repo_packages=()
  local aur_packages=()
  local package

  for package in "${packages[@]}"; do
    if pacman -Si "$package" >/dev/null 2>&1; then
      repo_packages+=("$package")
    else
      aur_packages+=("$package")
    fi
  done

  if ((${#repo_packages[@]} > 0)); then
    info "Installing repository packages in CI..."
    sudo pacman -S --needed --noconfirm "${repo_packages[@]}"
  fi

  if ((${#aur_packages[@]} > 0)); then
    info "Skipping AUR source builds in CI:"
    printf '  - %s\n' "${aur_packages[@]}"
  fi
{{ else }}
  paru -S --needed --noconfirm "${packages[@]}"
{{ end }}
}

setup_pacman_cleaner() {
  if ! has_systemd; then
    return 0
  fi

  info "Setting up pacman cache retention..."
  sudo tee /etc/systemd/system/pacman-cleaner.service >/dev/null <<'EOF'
[Unit]
Description=Prune old pacman package cache entries

[Service]
Type=oneshot
ExecStart=/usr/bin/paccache -r -k 3
EOF

  sudo tee /etc/systemd/system/pacman-cleaner.timer >/dev/null <<'EOF'
[Unit]
Description=Prune old pacman package cache entries weekly

[Timer]
OnCalendar=weekly
AccuracySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF

  sudo systemctl daemon-reload
  sudo systemctl enable --now pacman-cleaner.timer
}

setup_arch_services() {
  if ! has_systemd; then
    return 0
  fi

  info "Configuring Arch Linux services..."

  sudo tee /etc/systemd/zram-generator.conf >/dev/null <<'EOF'
[zram0]
zram-size = ram
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
EOF
  sudo systemctl daemon-reload
  sudo systemctl start systemd-zram-setup@zram0.service

  sudo systemctl enable --now earlyoom
  sudo systemctl enable --now fstrim.timer
  sudo systemctl enable --now ananicy-cpp
  sudo systemctl enable --now irqbalance
  sudo systemctl enable --now docker

  {{ if eq .cpu_vendor "intel" -}}
  info "Enabling thermald for Intel CPU..."
  sudo systemctl enable --now thermald
  {{- end }}

  setup_pacman_cleaner
}

check_pacman_lock
sync_arch_system
install_paru
install_arch_packages
setup_arch_services

{{ end -}}
