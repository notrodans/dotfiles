{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

USER=${USER:-$(id -un)}

# tmux config hash: {{ include "dot_tmux.conf" | sha256sum }}

info() { echo -e "\033[34m[INFO]\033[0m $*"; }
warn() { echo -e "\033[33m[WARN]\033[0m $*"; }

installer="$HOME/.tmux/plugins/tpm/bin/install_plugins"

if [[ ! -x "$installer" ]]; then
  warn "TPM plugin installer is unavailable at $installer"
  exit 1
fi

info "Installing configured tmux plugins..."
"$installer"

{{ end -}}
