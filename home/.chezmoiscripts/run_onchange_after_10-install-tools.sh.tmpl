{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

USER=${USER:-$(id -un)}

info() { echo -e "\033[34m[INFO]\033[0m $*"; }
warn() { echo -e "\033[33m[WARN]\033[0m $*"; }

install_oh_my_zsh() {
  if [[ -d "$HOME/.oh-my-zsh" ]]; then
    info "Oh My Zsh already installed"
  else
    info "Installing Oh My Zsh..."
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
  fi

  if [[ "$SHELL" != */zsh ]]; then
    info "Changing shell to zsh..."
    if command -v zsh >/dev/null 2>&1; then
      sudo chsh -s "$(command -v zsh)" "$USER"
    else
      warn "zsh not found, skipping chsh"
    fi
  fi
}

install_sdkman() {
  set +u
  if [[ -d "$HOME/.sdkman" ]]; then
    info "SDKMAN already installed at $HOME/.sdkman"
  else
    info "Installing SDKMAN..."
    curl -fsSL "https://get.sdkman.io?rcupdate=false" | bash
  fi

  export SDKMAN_DIR="$HOME/.sdkman"
  # shellcheck disable=SC1091
  [[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

  if command -v sdk >/dev/null 2>&1; then
    info "Installing Java versions via SDKMAN..."
    if ! command -v zip >/dev/null 2>&1 || ! command -v unzip >/dev/null 2>&1; then
      warn "zip/unzip not found. SDKMAN might fail to install packages."
    fi

    local version
    for version in{{ range .tool_versions.java.install }} {{ . | quote }}{{ end }}; do
      sdk install java "$version" || true
    done
    sdk default java {{ .tool_versions.java.default | quote }}
    sdk version
  else
    warn "SDKMAN was installed but 'sdk' command is not available in current shell."
  fi
  set -u
}

install_tpm() {
  local tpm_dir="$HOME/.tmux/plugins/tpm"
  local installer="$tpm_dir/bin/install_plugins"

  if [[ -d "$tpm_dir" ]]; then
    info "TPM already installed at $tpm_dir"
  else
    info "Installing TPM..."
    git clone --depth 1 https://github.com/tmux-plugins/tpm "$tpm_dir"
  fi

  if [[ ! -x "$installer" ]]; then
    warn "TPM plugin installer is unavailable at $installer"
    return 1
  fi

  info "Installing configured tmux plugins..."
  "$installer"
}

install_nvm() {
  local nvm_dir="$HOME/.nvm"
  local nvm_version={{ .tool_versions.nvm | quote }}
  local node_version={{ .tool_versions.node | quote }}

  if [[ -d "$nvm_dir/.git" ]]; then
    info "Updating NVM checkout to $nvm_version..."
    git -C "$nvm_dir" fetch --depth 1 --force origin "refs/tags/$nvm_version:refs/tags/$nvm_version"
  else
    info "Installing NVM $nvm_version..."
    git clone --depth 1 --branch "$nvm_version" https://github.com/nvm-sh/nvm.git "$nvm_dir"
  fi

  git -C "$nvm_dir" checkout --detach "$nvm_version"

  export NVM_DIR="$nvm_dir"
  # shellcheck disable=SC1091
  [[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"

  if command -v nvm >/dev/null 2>&1; then
    info "Installing Node.js $node_version via NVM..."
    nvm install "$node_version"
    nvm use "$node_version"
    nvm alias default "$node_version"
  else
    warn "NVM installed but 'nvm' command not found in current shell"
  fi
}

install_gh_stack() {
  local version={{ .tool_versions.gh_stack | quote }}

  if ! command -v gh >/dev/null 2>&1; then
    warn "GitHub CLI not found, skipping gh-stack"
    return
  fi

  info "Installing gh-stack $version..."
  gh extension install github/gh-stack --pin "$version" --force
}

install_oh_my_zsh
install_sdkman
install_tpm
install_nvm
install_gh_stack

{{ end -}}
