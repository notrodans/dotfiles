---
{{- $ephemeral := env "CHEZMOI_EPHEMERAL" | not | not -}}
{{- $headless := env "CHEZMOI_HEADLESS" | not | not -}}
{{- $upgrade := eq (env "CHEZMOI_UPGRADE") "true" -}}

{{- $cpuVendor := "unknown" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $cpuInfo := output "cat" "/proc/cpuinfo" -}}
{{-   if contains "GenuineIntel" $cpuInfo -}}
{{-     $cpuVendor = "intel" -}}
{{-   else if contains "AuthenticAMD" $cpuInfo -}}
{{-     $cpuVendor = "amd" -}}
{{-   end -}}
{{- end -}}

{{- $gpuVendorIDs := "" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $gpuVendorIDs = output "bash" "-c" "for device in /sys/bus/pci/devices/*; do [ -r \"$device/class\" ] && [ -r \"$device/vendor\" ] || continue; case \"$(cat \"$device/class\")\" in 0x03*) cat \"$device/vendor\" ;; esac; done" -}}
{{- end -}}
{{- $gpuIntel := contains "0x8086" $gpuVendorIDs -}}
{{- $gpuAmd := contains "0x1002" $gpuVendorIDs -}}
{{- $gpuNvidia := contains "0x10de" $gpuVendorIDs -}}

{{- $isLaptop := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $battery := output "bash" "-c" "for battery in /sys/class/power_supply/BAT*; do if [ -d \"$battery\" ]; then printf present; break; fi; done" -}}
{{-   $isLaptop = eq $battery "present" -}}
{{- end -}}

{{- $ci := eq (env "CI") "true" -}}
{{- $codespaces := env "CODESPACES" | not | not -}}
{{- $devContainer := env "REMOTE_CONTAINERS" | not | not -}}
{{- $interactive := stdinIsATTY -}}

{{- if or $ci $codespaces $devContainer -}}
{{-   $ephemeral = true -}}
{{-   $headless = true -}}
{{- else if $interactive -}}
{{-   $ephemeral = promptBoolOnce . "ephemeral" "ephemeral" -}}
{{-   $headless = promptBoolOnce . "headless" "headless" -}}
{{- end -}}

{{- $user := env "USER" | default (output "id" "-un" | trim) -}}
{{- $name := env "NAME" | default $user -}}
{{- $email := env "EMAIL" | default (printf "%s@localhost" $user) -}}

{{- $secrets := false -}}
{{- if not $ephemeral -}}
{{-   if $interactive -}}
{{-     $secrets = promptBoolOnce . "secrets" "enable bitwarden secrets" -}}
{{-   else -}}
{{-     $secrets = true -}}
{{-   end -}}
{{- end -}}

{{- if hasKey . "name" -}}
{{-   $name = .name -}}
{{- else if env "GIT_CONFIG_USER_NAME" -}}
{{-   $name = env "GIT_CONFIG_USER_NAME" -}}
{{- else if $interactive -}}
{{-   $name = promptString "name" $name -}}
{{- end -}}

{{- if hasKey . "email" -}}
{{-   $email = .email -}}
{{- else if env "GIT_CONFIG_USER_EMAIL" -}}
{{-   $email = env "GIT_CONFIG_USER_EMAIL" -}}
{{- else if $interactive -}}
{{-   $email = promptString "email" $email -}}
{{- end -}}

{{- if $interactive -}}
{{-   writeToStdout "💡 Tip: you can re-enter your name and email with `chezmoi init --data=false`.\n" -}}
{{- end -}}

sourceDir: {{ .chezmoi.sourceDir | quote }}

data:
  user: {{ $user | quote }}
  email: {{ $email | quote }}
  name: {{ $name | quote }}
  ephemeral: {{ $ephemeral }}
  headless: {{ $headless }}
  codespaces: {{ $codespaces }}
  ci: {{ $ci }}
  devContainer: {{ $devContainer }}
  secrets: {{ $secrets }}

  # Upgrade packages
  upgrade: {{ $upgrade }}

  cpu_vendor: {{ $cpuVendor | quote }}
  gpu_intel: {{ $gpuIntel }}
  gpu_amd: {{ $gpuAmd }}
  gpu_nvidia: {{ $gpuNvidia }}
  is_laptop: {{ $isLaptop }}

diff:
  # exclude:
  #   - externals
  #   - scripts

github:
  refreshPeriod: 12h

bitwarden:
  command: "bw"

scriptEnv:
{{- if eq .chezmoi.os "linux" }}
  DEBIAN_FRONTEND: noninteractive
{{- end }}

  TMPDIR: {{ coalesce .chezmoi.config.tempDir (env "TMPDIR") (env "TMP") "/tmp" | quote }}

# Files and directories not group writeable
# umask: 0o022
