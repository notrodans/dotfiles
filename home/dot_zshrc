export MASON="$HOME/.local/share/nvim/mason"
export ZSH="$HOME/.oh-my-zsh"
export NVM_DIR="$HOME/.nvm"

plugins=(git kubectl docker sudo)

ZSH_THEME="crunch"
source "$ZSH/oh-my-zsh.sh"
zstyle ':completion:*' matcher-list \
	'' \
	'm:{a-zA-Z}={A-Za-z}'

if [[ -n ${KITTY_WINDOW_ID-} ]]; then
	# Keep cursor positioning inside PROMPT so ZLE owns the complete redraw lifecycle.
	# Move to the bottom screen row, clear it, then render the actual theme prompt.
	PROMPT=$'%{\r\e[999B\e[2K%}'"$PROMPT"
fi

export EDITOR=nvim
export SUDO_EDITOR=nvim

typeset -U path PATH
path=(
	"$HOME/.local/bin"
	$path
)
export PATH

alias clipfzf="cliphist list | fzf | cliphist decode | wl-copy"
alias pacall="pacman -Qq | fzf --multi --preview 'pacman -Qi {1}' | xargs -ro sudo pacman -Rns"
alias ls="ls --sort=time -r"

_load_nvm() {
	local init="$NVM_DIR/nvm.sh"

	if [[ ! -s "$init" ]]; then
		print -u2 "nvm is not installed at $NVM_DIR"
		return 127
	fi

	unfunction nvm npm node npx 2>/dev/null || true
	source "$init" --no-use
	nvm use default --silent >/dev/null 2>&1 || true
}

nvm() {
	_load_nvm || return
	nvm "$@"
}

npm() {
	_load_nvm || return
	npm "$@"
}

node() {
	_load_nvm || return
	node "$@"
}

npx() {
	_load_nvm || return
	npx "$@"
}

fman() {
    local selected name section

    selected="$(
        {
            # Explicit MANPATH entries, if configured
            if [[ -n "$MANPATH" ]]; then
                printf '%s\n' "${(@s/:/)MANPATH}"
            fi

            # Standard locations
            printf '%s\n' \
                /usr/share/man \
                /usr/local/share/man \
                /usr/local/man \
                "$HOME/.local/share/man"
        } |
        awk 'NF && !seen[$0]++' |
        while IFS= read -r root; do
            [[ -d "$root" ]] || continue

            find "$root" -type f \
                \( -path '*/man[0-9]*/*' -o -path '*/mann/*' -o -path '*/manl/*' \) \
                2>/dev/null
        done |
        sed -E '
            s#^.*/##
            s#\.(gz|bz2|xz|zst|lzma)$##
        ' |
        awk '
            {
                section = $0
                sub(/^.*\./, "", section)

                name = $0
                sub(/\.[^.]+$/, "", name)

                printf "%s\t%s\n", name, section
            }
        ' |
        sort -u |
		fzf \
			--delimiter=$'\t' \
			--with-nth=1,2 \
			--prompt='man> ' \
			--border=rounded \
			--info=inline-right \
			--preview='man {2} {1} 2>/dev/null | col -bx' \
			--preview-window='right:65%,wrap-word,border-left' \
			--preview-wrap-sign='' \
			--no-scrollbar \
			--bind='enter:execute(man {2} {1})' \
			--bind='ctrl-u:preview-half-page-up' \
			--bind='ctrl-d:preview-half-page-down'
    )" || return

    [[ -z "$selected" ]] && return

    name="${selected%%$'\t'*}"
    section="${selected##*$'\t'}"

    man "$section" "$name"
}

