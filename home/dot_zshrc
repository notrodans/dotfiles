export MASON="$HOME/.local/share/nvim/mason"
export ZSH="$HOME/.oh-my-zsh"
export NVM_DIR="$HOME/.nvm"
export SDKMAN_DIR="$HOME/.sdkman"

plugins=(git kubectl docker sudo)

ZSH_THEME="crunch"
source "$ZSH/oh-my-zsh.sh"
zstyle ':completion:*' matcher-list \
	'' \
	'm:{a-zA-Z}={A-Za-z}'

if [[ -n ${KITTY_WINDOW_ID-} ]]; then
	# Keep cursor positioning inside PROMPT so ZLE owns the complete redraw lifecycle.
	# Move to the bottom screen row, clear it, then render the actual theme prompt.
	PROMPT=$'%{\r\e[999B\e[2K%}'"$PROMPT"
fi

export EDITOR=nvim
export SUDO_EDITOR=nvim

typeset -U path PATH
path=(
	"$HOME/.local/bin"
	"$SDKMAN_DIR/candidates/java/current/bin"
	$path
)
export PATH

alias current-size="du -ch --max-depth 1 . | sort -rh"
alias pacfzf="pacman -Slq | fzf --multi --preview 'pacman -Si {1}' | xargs -ro sudo pacman -Syu --needed"
alias pacall="pacman -Qq | fzf --multi --preview 'pacman -Qi {1}' | xargs -ro sudo pacman -Rns"
alias ls="ls --sort=time -r"

_load_nvm() {
	local init="$NVM_DIR/nvm.sh"

	if [[ ! -s "$init" ]]; then
		print -u2 "nvm is not installed at $NVM_DIR"
		return 127
	fi

	unfunction nvm npm node npx 2>/dev/null || true
	source "$init" --no-use
	nvm use default --silent >/dev/null 2>&1 || true
}

nvm() {
	_load_nvm || return
	nvm "$@"
}

npm() {
	_load_nvm || return
	npm "$@"
}

node() {
	_load_nvm || return
	node "$@"
}

npx() {
	_load_nvm || return
	npx "$@"
}

_load_sdkman() {
	local init="$SDKMAN_DIR/bin/sdkman-init.sh"

	if [[ ! -s "$init" ]]; then
		print -u2 "SDKMAN is not installed at $SDKMAN_DIR"
		return 127
	fi

	unfunction sdk 2>/dev/null || true
	source "$init"
}

sdk() {
	_load_sdkman || return
	sdk "$@"
}

