export MASON="$HOME/.local/share/nvim/mason"
export ZSH="$HOME/.oh-my-zsh"

plugins=(git kubectl docker sudo)

ZSH_THEME="crunch"
source $ZSH/oh-my-zsh.sh
zstyle ':completion:*' matcher-list \
	'' \
	'm:{a-zA-Z}={A-Za-z}'

autoload -Uz add-zsh-hook

typeset -gi BOTTOM_PROMPT_LINES=1

__prompt_to_bottom() {
    [[ -n ${KITTY_WINDOW_ID-} ]] || return

    # Возвращаемся в начало строки и двигаемся максимально вниз.
    printf '\r\e[999B'

    # Для многострочного prompt поднимаемся выше,
    # чтобы последняя строка ввода оказалась снизу.
    if (( BOTTOM_PROMPT_LINES > 1 )); then
        printf '\e[%dA' $((BOTTOM_PROMPT_LINES - 1))
    fi
}

add-zsh-hook precmd __prompt_to_bottom

export EDITOR=nvim
export SUDO_EDITOR=nvim

alias current-size="du -ch --max-depth 1 . | sort -rh"
alias pacfzf="pacman -Slq | fzf --multi --preview 'pacman -Si {1}' | xargs -ro sudo pacman -Syy"
alias pacall="pacman -Qq | fzf --multi --preview 'pacman -Qi {1}' | xargs -ro sudo pacman -Rns"
alias ls="ls --sort=time -r"

alias nvm='. ~/loadnvm.sh; nvm "$@"'
alias npm='. ~/loadnvm.sh; npm "$@"'
alias node='. ~/loadnvm.sh; node "$@"'

# opencode
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"

# Added by Antigravity CLI installer
export PATH="/home/notrodans/.local/bin:$PATH"

export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"


# >>> oh-my-opencode-slim background subagents >>>
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
